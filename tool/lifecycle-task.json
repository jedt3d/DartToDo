{
  "id": "local-todo",
  "title": "Local To Do clone for macOS, iPad and iPhone",
  "kind": "feature",
  "acceptance": [
    "Task/list/group persistence, search, steps, dates, recurrence and undo work against real local PostgreSQL",
    "Native macOS and iOS simulator apps build and run with adaptive UI and loopback-only Serverpod",
    "Every production widget has a current runtime catalog case; visual, accessibility and Figma evidence reported separately",
    "Source-only GitHub version release contains documents and real-app screenshots without private data"
  ],
  "checks": [
    {
      "id": "analyze",
      "description": "analyze",
      "command": {
        "executable": "flutter",
        "args": [
          "analyze",
          "--no-pub",
          "--fatal-infos"
        ],
        "cwd": ".",
        "timeoutMs": 180000
      },
      "requiredFor": [
        "verified"
      ],
      "inputEnv": [
        "DEVELOPER_DIR",
        "FLUTTER_ROOT",
        "PUB_CACHE"
      ]
    },
    {
      "id": "flutter-behavior",
      "description": "flutter behavior",
      "command": {
        "executable": "flutter",
        "args": [
          "test",
          "--no-pub"
